{
  "version": 2,
  "buildCommand": "pnpm --filter \"@workspace/venoxa\" run build",
  "installCommand": "pnpm install",
  "outputDirectory": "artifacts/venoxa/dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/((?!api/|assets/|data/).*\\..*)", "destination": "/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
